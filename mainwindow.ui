  <property name="styleSheet">
   <string notr="true">QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 12px;
}

/* Regla exclusiva para la barra lateral izquierda (Herramientas de Elementos) */
QToolBar#toolbarElementos QToolButton {
    min-width: 130px;        /* Hace todos los botones más anchos y uniformes */
    text-align: right;       /* Alinea el texto a la derecha */
}

/* Efecto visual cuando el usuario pasa el ratón por encima (Hover) */
QToolBar QToolButton:hover {
    background-color: #e1e1e1;
    border: 1px solid #cccccc;
}

/* ESTADO PRESIONADO / ACTIVADO (Checked) */
QToolBar QToolButton:checked {
    background-color: #1e3a8a;
    border: 2px solid #3b82f6;
    color: #ffffff;
    font-weight: bold;
}
    
/* --- CONTROL DEL LIENZO MOLECULAR --- */
QGraphicsView#visorMolecular {
    background-color: #1e1e1e; /* Gris carbón oscuro (estilo editor 3D/CAD) */
    border: 1px solid #333333; /* Borde oscuro sutil */
}

/* Estado bloqueado del lienzo (Enabled = false) */
QGraphicsView#visorMolecular:disabled {
    background-color: #2d2d2d; /* Gris mate atenuado */
    border: 1px solid #222222; /* Borde hundido */
}</string>
  </property>
