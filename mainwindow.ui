  <property name="styleSheet">
   <string notr="true">/* Estilo general para todos los botones de la barra de herramientas */
QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px; /* Ajusta este valor para redondear más o menos las esquinas */
    padding: 4px;
}

/* Efecto visual cuando el usuario pasa el ratón por encima (Hover) */
QToolBar QToolButton:hover {
    background-color: #e1e1e1; /* Gris claro */
    border: 1px solid #cccccc;
}

/* ESTADO PRESIONADO / ACTIVADO (Checked) */
QToolBar QToolButton:checked {
    background-color: #1e3a8a; /* Fondo azul marino oscuro */
    border: 2px solid #3b82f6;     /* Borde azul brillante */
    color: #ffffff;                /* TEXTO BLANCO: Se lee perfectamente */
    font-weight: bold;
}</string>
